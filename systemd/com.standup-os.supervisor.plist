<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Supervisor cycle (docs/supervisor.md), every 15 min. Template: install with
     cp systemd/com.standup-os.supervisor.plist ~/Library/LaunchAgents/ &&
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.standup-os.supervisor.plist -->
<plist version="1.0"><dict>
<key>Label</key><string>com.standup-os.supervisor</string>
<key>ProgramArguments</key><array>
<string>/usr/bin/env</string><string>python3</string>
<string>/Users/urirozen_m4/projects/standup-os/bin/supervisor.py</string><string>cycle</string></array>
<key>EnvironmentVariables</key><dict>
<key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/Users/urirozen_m4/.local/bin:/Users/urirozen_m4/bin</string>
</dict>
<key>StartInterval</key><integer>900</integer>
<key>RunAtLoad</key><false/>
<key>StandardOutPath</key><string>/dev/null</string>
<key>StandardErrorPath</key><string>/tmp/standup-supervisor.log</string>
</dict></plist>
