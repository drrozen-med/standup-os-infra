[Unit]
Description=Mattermost Agent Daemon - %i
After=network.target
Wants=network.target

[Service]
Type=simple
User=claude-agent
WorkingDirectory=${STANDUP_OS_ROOT}
Environment=PLATFORM=vm
EnvironmentFile=/etc/nursebridge/mm-agent.env
RuntimeDirectory=mm-daemon
RuntimeDirectoryMode=0755
ExecStartPre=/bin/bash -lc 'inst="%i"; agent="${inst%-worker}"; session="${inst}"; exec ${STANDUP_OS_ROOT}/apps/standup-os/ai-team-members/mm-daemon-wrapper.sh --preonly "$agent" "$session"'
ExecStart=/usr/local/libexec/mm-agent-launch.sh %i
Restart=always
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=120
TimeoutStartSec=60
MemoryMax=1G
MemoryHigh=768M
CPUQuota=20%
TasksMax=100

[Install]
WantedBy=multi-user.target
